{
  "expo": {
    "name": "TaskLink",
    "slug": "tasklink",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/tasklink_image.png",
    "scheme": "tasklink",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.infinityquestlabs.tasklink",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/tasklink_image.png",
        "backgroundImage": "./assets/images/tasklink_image.png",
        "monochromeImage": "./assets/images/tasklink_image.png"
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/tasklink_image.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/tasklink_image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "@clerk/expo",
      "expo-secure-store",
      "expo-sharing",
      "expo-status-bar",
      "expo-web-browser",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3e69546d-dc99-4932-a281-07304ceb0d75"
      }
    },
    "owner": "josh001"
  }
}
